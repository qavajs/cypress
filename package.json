{
  "name": "@qavajs/cypress",
  "version": "2.9.0",
  "description": "qavajs for cypress runner",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./po": {
      "types": "./po.d.ts",
      "default": "./po.js"
    },
    "./defineQavajs": {
      "types": "./defineQavajs.d.ts",
      "default": "./defineQavajs.js"
    }
  },
  "scripts": {
    "debug": "cypress open --config-file test-e2e/cypress.config.js",
    "debug:it": "MODE=it cypress open --config-file test-e2e/cypress.config.js",
    "test": "cypress run --config-file test-e2e/cypress.config.js",
    "test:it": "MODE=it cypress run --config-file test-e2e/cypress.config.js"
  },
  "keywords": [
    "QA",
    "testing",
    "test-automation",
    "cypress",
    "qavajs",
    "cucumber",
    "cucumberjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qavajs/cypress.git"
  },
  "bugs": {
    "url": "https://github.com/qavajs/cypress/issues"
  },
  "homepage": "https://github.com/qavajs/cypress#readme",
  "author": "Alexandr Galichenko",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@qavajs/cypress-runner-adapter": "^1.11.0",
    "@qavajs/memory": "^1.11.0",
    "cypress": "^15.15.0"
  }
}
